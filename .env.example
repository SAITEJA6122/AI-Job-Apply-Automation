# API Keys for LLM Integration
# Copy this file to .env and fill in your actual keys

# Gemini API Key (Primary)
# Get your free key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Groq API Key (Optional Fallback)
# Get your free key from: https://console.groq.com/keys
# Used if Gemini quota is exhausted
GROQ_API_KEY=your-groq-api-key-here

# OpenRouter API Key (Optional Fallback)
# Get your free key from: https://openrouter.ai/keys
# Used if Gemini and Groq are unavailable
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Email Notification Configuration (Optional)
# Configure SMTP settings to receive email notifications after job application runs
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_FROM_EMAIL=your-email@gmail.com
# NOTIFICATION_TO_EMAIL=your-email@gmail.com
